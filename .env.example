# Next.js / NextAuth
AUTH_SECRET=                        # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Database (Neon or any PostgreSQL)
DATABASE_URL=postgresql://user:password@host/pgm_dashboard?sslmode=require

# Encryption key for stored API tokens
ENCRYPTION_KEY=                     # openssl rand -hex 32  (64 hex chars = 32 bytes)

# Seed script only — set a strong password, change after first login
SEED_ADMIN_PASSWORD=
