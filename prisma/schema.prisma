generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  passwordHash          String
  role                  Role      @default(CLIENT)
  clientId              String?
  client                Client?   @relation(fields: [clientId], references: [id])
  passwordResetRequired Boolean   @default(false)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

enum Role {
  ADMIN
  CLIENT
}

model Client {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  users      User[]
  dataConfig DataSourceConfig?
  createdAt  DateTime          @default(now())
}

// ─── CRM ────────────────────────────────────────────────────────────────────

model Contact {
  id              String          @id @default(cuid())
  firstName       String
  lastName        String
  linkedinUrl     String?         @unique
  email           String?
  company         String?
  position        String?
  connectedOn     DateTime?

  titleTier       TitleTier       @default(OTHER)
  industrySegment IndustrySegment @default(UNKNOWN)
  outreachStatus  OutreachStatus  @default(NOT_STARTED)
  priorityScore   Int             @default(0)

  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?

  notes           ContactNote[]
  outreachLogs    OutreachLog[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model OutreachLog {
  id        String       @id @default(cuid())
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      OutreachType
  notes     String?
  sentAt    DateTime     @default(now())
}

enum TitleTier {
  TIER_1
  TIER_2
  TIER_3
  OTHER
}

enum IndustrySegment {
  PRIVATE_MEMBERS_CLUB
  RESORT_GOLF
  MUNICIPAL_PUBLIC
  GOLF_ACADEMY
  GOLF_RETAIL
  GOLF_MEDIA
  SUPPLIER_VENDOR
  ASSOCIATION
  UNKNOWN
}

enum OutreachStatus {
  NOT_STARTED
  MESSAGED
  REPLIED
  MEETING_BOOKED
  NOT_INTERESTED
  NO_RESPONSE
}

enum OutreachType {
  LINKEDIN_MESSAGE
  EMAIL
  CALL
  MEETING
}

// ─── Data Sources ────────────────────────────────────────────────────────────

model DataSourceConfig {
  id                       String   @id @default(cuid())
  clientId                 String   @unique
  client                   Client   @relation(fields: [clientId], references: [id])

  // GA4
  ga4PropertyId            String?
  ga4ServiceAccountJson    String?
  ga4BookingEventName      String?  @default("generate_lead")
  ga4MembershipEventName   String?  @default("membership_enquiry")

  // Meta
  metaAdAccountId          String?
  metaAccessToken          String?

  // Email Octopus
  emailOctopusApiKey       String?
  emailOctopusListId       String?

  updatedAt                DateTime @updatedAt
}
