generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  passwordHash          String
  role                  Role      @default(CLIENT)
  clientId              String?
  client                Client?   @relation(fields: [clientId], references: [id])
  passwordResetRequired Boolean   @default(false)
  // The person's name, shown against their changes in the enquiry history
  displayName           String?
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

enum Role {
  ADMIN
  CLIENT
}

model Client {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  users      User[]
  dataConfig DataSourceConfig?
  createdAt  DateTime          @default(now())

  // Secret part of the URL that website forms post enquiries to
  intakeToken String?          @unique
  // Demo club: every tab shows sample data (for showing prospects)
  isDemo      Boolean          @default(false)
  // Club branding on its dashboard
  logoUrl     String?
  brandColor  String?
  // When Pure Golf Media's work started; email results are shown from here on
  reportingStartDate DateTime?
  // Membership value goal (e.g. £348k now → £500k), tracked with monthly entries
  membershipBaseline   Float?
  membershipTarget     Float?
  membershipTargetDate DateTime?
  enquiries   Enquiry[]
  contacts    Contact[]
  crmSettings CrmSettings?
  alertRecipients AlertRecipient[]
  goals       Goal[]
  notes       Note[]
  membershipValues MembershipValue[]
}

// One month's total membership value (and member count), entered by Pure Golf Media
model MembershipValue {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime
  value     Float
  members   Int?
  createdAt DateTime @default(now())

  @@index([clientId, date])
}

// ─── Enquiries, goals and work notes ─────────────────────────────────────────

// Pipeline stage. BOOKED is the "won" stage: shown as "Joined" for membership
// enquiries and "Booked" for everything else.
enum EnquiryStatus {
  NEW
  CONTACTED
  TOUR_BOOKED
  BOOKED
  LOST
}

enum EnquiryType {
  MEMBERSHIP
  WEDDING
  SOCIETY
  DRIVING_RANGE
  FUNCTION
  GENERAL
}

// One person at one club. Personal details are encrypted in the app before they
// reach the database (see src/lib/pii.ts); the hashes find repeat enquirers and
// deletion requests without decrypting anything.
model Contact {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nameEnc          String?
  emailEnc         String?
  phoneEnc         String?
  emailHash        String?
  phoneHash        String?
  // Proof of opt-in to marketing emails (needed before adding them to Mailchimp)
  marketingConsent Boolean   @default(false)
  consentAt        DateTime?
  consentWording   String?
  lastActivityAt   DateTime  @default(now())
  anonymisedAt     DateTime?
  createdAt        DateTime  @default(now())
  enquiries        Enquiry[]

  @@unique([clientId, emailHash])
  @@index([clientId, phoneHash])
  @@index([lastActivityAt])
  // An older, unused "Contact" table (LinkedIn prospecting) still exists in the database
  @@map("ClubContact")
}

model Enquiry {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  receivedAt     DateTime      @default(now())
  type           EnquiryType   @default(GENERAL)
  // website_form | facebook_lead | instagram_lead | phone | walk_in | email | manual
  source         String        @default("manual")
  sourceDetail   String?       // e.g. which form or campaign
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  category       String?       // finer detail, e.g. "Christmas party"
  eventDate      String?       // as the person wrote it
  messageEnc     String?
  staffNotesEnc  String?
  status         EnquiryStatus @default(NEW)
  stageChangedAt DateTime?
  bookedValue    Float?        // £ value when won (membership fee or booking value)
  bookedAt       DateTime?     // when it was won
  lostReason     String?
  anonymisedAt   DateTime?
  updatedAt      DateTime      @updatedAt
  events         EnquiryEvent[]
  jobs           OutboundJob[]

  // Old plain-text fields. New code never writes them; existing rows are moved
  // into the encrypted fields automatically (src/lib/crm.ts) and then cleared.
  name           String?
  email          String?
  phone          String?
  message        String?
  staffNotes     String?

  @@index([clientId, receivedAt])
  @@index([clientId, status])
  @@index([contactId])
}

// History of an enquiry: created, stage changes, notes, sends. No personal details.
model EnquiryEvent {
  id          String   @id @default(cuid())
  enquiryId   String
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  clientId    String
  at          DateTime @default(now())
  actorUserId String?  // null = the system
  actorName   String?
  kind        String   // created | stage | note | value | type | mailchimp | whatsapp
  fromValue   String?
  toValue     String?
  detail      String?

  @@index([enquiryId, at])
  @@index([clientId, at])
}

// Sends to Mailchimp and WhatsApp, kept until they succeed so nothing is lost
model OutboundJob {
  id            String    @id @default(cuid())
  clientId      String
  enquiryId     String?
  enquiry       Enquiry?  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  channel       String    // mailchimp | whatsapp
  recipientId   String?   // AlertRecipient for WhatsApp
  status        String    @default("pending") // pending | sent | failed
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  providerRef   String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([enquiryId])
}

// Per-club CRM settings
model CrmSettings {
  id                   String   @id @default(cuid())
  clientId             String   @unique
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enabled              Boolean  @default(false)
  mailchimpSyncEnabled Boolean  @default(false)
  mailchimpAudienceId  String?  // defaults to the reporting list
  mailchimpTags        Json?    // { "MEMBERSHIP": "Enquiry – Membership", ... }
  whatsappEnabled      Boolean  @default(false)
  alertIncludesPhone   Boolean  @default(false)
  retentionMonths      Int      @default(24)
  updatedAt            DateTime @updatedAt
}

// Club staff who get a WhatsApp alert for new enquiries
model AlertRecipient {
  id                 String        @id @default(cuid())
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String
  phoneEnc           String
  phoneLast4         String
  types              EnquiryType[] // empty = every type
  active             Boolean       @default(true)
  consentConfirmedAt DateTime?
  createdAt          DateTime      @default(now())

  @@index([clientId])
}

// Failed sign-ins, kept in the database so the limit holds across servers
model LoginAttempt {
  key           String    @id
  failures      Int       @default(0)
  firstFailedAt DateTime  @default(now())
  blockedUntil  DateTime?
}

enum GoalMetric {
  ENQUIRIES
  BOOKINGS
  REVENUE
}

model Goal {
  id        String     @id @default(cuid())
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  metric    GoalMetric
  category  String?    // count only enquiries in this category; empty = all
  target    Float
  startDate DateTime
  deadline  DateTime
  createdAt DateTime   @default(now())

  @@index([clientId])
}

model Note {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime // the day the work happened
  text      String
  createdAt DateTime @default(now())

  @@index([clientId, date])
}

// ─── Data Sources ────────────────────────────────────────────────────────────

model DataSourceConfig {
  id                       String   @id @default(cuid())
  clientId                 String   @unique
  client                   Client   @relation(fields: [clientId], references: [id])

  // GA4
  ga4PropertyId            String?
  ga4ServiceAccountJson    String?
  ga4BookingEventName      String?  @default("generate_lead")
  ga4MembershipEventName   String?  @default("membership_enquiry")
  // What the club calls those actions on its dashboard
  bookingGoalLabel         String?
  membershipGoalLabel      String?
  // Figures are only trusted from these dates (earlier days are left out)
  ga4TrackingStartDate     DateTime?
  ga4BookingStartDate      DateTime?
  // Golf / clubhouse split: page-address words for each side, and the golf-side GA4 events
  golfPageWords            String?
  clubhousePageWords       String?
  ga4GolfEventNames        String?

  // Meta
  metaAdAccountId          String?
  metaAccessToken          String?

  // Email Octopus
  emailOctopusApiKey       String?
  emailOctopusListId       String?

  // Mailchimp
  mailchimpApiKey          String?
  mailchimpListId          String?

  // Google Search Console (uses the GA4 service account)
  searchConsoleSiteUrl     String?

  updatedAt                DateTime @updatedAt
}

// Shared cache of data fetched from Google, Meta and Mailchimp (see src/lib/cache.ts)
model CacheEntry {
  key       String   @id
  value     Json
  fetchedAt DateTime
  expiresAt DateTime

  @@index([expiresAt])
}

// "Forgot password" requests from the login page, handled by Pure Golf Media
model PasswordHelpRequest {
  id        String    @id @default(cuid())
  username  String
  createdAt DateTime  @default(now())
  handledAt DateTime?

  @@index([handledAt])
}
