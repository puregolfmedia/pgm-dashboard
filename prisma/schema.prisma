generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  passwordHash          String
  role                  Role      @default(CLIENT)
  clientId              String?
  client                Client?   @relation(fields: [clientId], references: [id])
  passwordResetRequired Boolean   @default(false)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

enum Role {
  ADMIN
  CLIENT
}

model Client {
  id         String            @id @default(cuid())
  name       String
  slug       String            @unique
  users      User[]
  dataConfig DataSourceConfig?
  createdAt  DateTime          @default(now())

  // Secret part of the URL that website forms post enquiries to
  intakeToken String?          @unique
  // Demo club: every tab shows sample data (for showing prospects)
  isDemo      Boolean          @default(false)
  // Club branding on its dashboard
  logoUrl     String?
  brandColor  String?
  enquiries   Enquiry[]
  goals       Goal[]
  notes       Note[]
}

// ─── Enquiries, goals and work notes ─────────────────────────────────────────

enum EnquiryStatus {
  NEW
  CONTACTED
  BOOKED
  LOST
}

model Enquiry {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  receivedAt  DateTime      @default(now())
  source      String        @default("manual") // "form" or "manual"
  category    String?       // e.g. "Christmas party"
  name        String?
  email       String?
  phone       String?
  eventDate   String?       // as the person wrote it
  message     String?
  status      EnquiryStatus @default(NEW)
  bookedValue Float?        // £, when booked
  bookedAt    DateTime?
  staffNotes  String?
  updatedAt   DateTime      @updatedAt

  @@index([clientId, receivedAt])
}

enum GoalMetric {
  ENQUIRIES
  BOOKINGS
  REVENUE
}

model Goal {
  id        String     @id @default(cuid())
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  metric    GoalMetric
  category  String?    // count only enquiries in this category; empty = all
  target    Float
  startDate DateTime
  deadline  DateTime
  createdAt DateTime   @default(now())

  @@index([clientId])
}

model Note {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime // the day the work happened
  text      String
  createdAt DateTime @default(now())

  @@index([clientId, date])
}

// ─── Data Sources ────────────────────────────────────────────────────────────

model DataSourceConfig {
  id                       String   @id @default(cuid())
  clientId                 String   @unique
  client                   Client   @relation(fields: [clientId], references: [id])

  // GA4
  ga4PropertyId            String?
  ga4ServiceAccountJson    String?
  ga4BookingEventName      String?  @default("generate_lead")
  ga4MembershipEventName   String?  @default("membership_enquiry")
  // What the club calls those actions on its dashboard
  bookingGoalLabel         String?
  membershipGoalLabel      String?

  // Meta
  metaAdAccountId          String?
  metaAccessToken          String?

  // Email Octopus
  emailOctopusApiKey       String?
  emailOctopusListId       String?

  // Mailchimp
  mailchimpApiKey          String?
  mailchimpListId          String?

  // Google Search Console (uses the GA4 service account)
  searchConsoleSiteUrl     String?

  updatedAt                DateTime @updatedAt
}

// Shared cache of data fetched from Google, Meta and Mailchimp (see src/lib/cache.ts)
model CacheEntry {
  key       String   @id
  value     Json
  fetchedAt DateTime
  expiresAt DateTime

  @@index([expiresAt])
}

// "Forgot password" requests from the login page, handled by Pure Golf Media
model PasswordHelpRequest {
  id        String    @id @default(cuid())
  username  String
  createdAt DateTime  @default(now())
  handledAt DateTime?

  @@index([handledAt])
}
